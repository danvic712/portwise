<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are consumed by the OpenAPI/Swagger integration; undocumented public members do not block the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SpaRoot>../DividendHarvest.Web/</SpaRoot>
    <SpaProxyServerUrl>http://127.0.0.1:4173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>pnpm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DividendHarvest.Host.Tests" />
  </ItemGroup>

  <!-- SpaProxy is only referenced in Debug: auto-starts the Vite dev server and reverse-proxies non-API requests via ASPNETCORE_HOSTINGSTARTUPASSEMBLIES. Not referenced in Release/Publish. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DividendHarvest.Application/DividendHarvest.Application.csproj" />
    <ProjectReference Include="../DividendHarvest.Infrastructure/DividendHarvest.Infrastructure.csproj" />
    <ProjectReference Include="../DividendHarvest.Web/portwise.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Optional frontend build integration, off by default (CI/Dockerfile build the frontend independently). Pass -p:BuildFrontend=true to enable on dotnet build/publish so wwwroot is populated. -->
  <Target Name="BuildFrontend"
          BeforeTargets="Build;Publish"
          Condition="'$(BuildFrontend)' == 'true'">
    <Exec Command="corepack enable &amp;&amp; pnpm install --frozen-lockfile"
          WorkingDirectory="../DividendHarvest.Web" />
    <Exec Command="pnpm build"
          WorkingDirectory="../DividendHarvest.Web" />
  </Target>
</Project>
