<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ASP.NET Core OpenAPI source generation consumes XML docs at compile time; undocumented public members do not block the build. -->
    <!-- API Versioning owns versioned OpenAPI registration while the direct native registration activates project-reference XML source generation. -->
    <NoWarn>$(NoWarn);CS1591;AV0029</NoWarn>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../Portwise.Web/openapi</OpenApiDocumentsDirectory>
    <!-- The checked-in publication is v1; additional document names must be generated with explicit stable file names. -->
    <OpenApiGenerateDocumentsOptions>--file-name portwise_v1</OpenApiGenerateDocumentsOptions>
    <SpaRoot>../Portwise.Web/</SpaRoot>
    <SpaProxyServerUrl>http://localhost:4173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>pnpm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portwise.Host.Tests" />
  </ItemGroup>

  <!-- SpaProxy is only referenced in Debug: auto-starts the Vite dev server and reverse-proxies non-API requests via ASPNETCORE_HOSTINGSTARTUPASSEMBLIES. Not referenced in Release/Publish. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Portwise.Application/Portwise.Application.csproj" />
    <ProjectReference Include="../Portwise.Infrastructure/Portwise.Infrastructure.csproj" />
    <ProjectReference Include="../Portwise.Web/portwise.esproj" Condition="'$(Configuration)' == 'Debug'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Optional frontend build integration, off by default (CI/Dockerfile build the frontend independently). Pass -p:BuildFrontend=true to enable on dotnet build/publish so wwwroot is populated. -->
  <Target Name="BuildFrontend"
          BeforeTargets="Build;Publish"
          Condition="'$(BuildFrontend)' == 'true'">
    <Exec Command="corepack enable &amp;&amp; pnpm install --frozen-lockfile"
          WorkingDirectory="../Portwise.Web" />
    <Exec Command="pnpm build"
          WorkingDirectory="../Portwise.Web" />
  </Target>
</Project>
